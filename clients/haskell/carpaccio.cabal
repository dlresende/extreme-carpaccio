cabal-version:      3.0
name:               extreme-carpaccio
version:            0.1.0.0
synopsis:           Minimal Haskell client for the Extreme Carpaccio kata
build-type:         Simple
license:            MIT

executable extreme-carpaccio
  main-is:          Main.hs
  hs-source-dirs:   src
  other-modules:    App
  build-depends:    base >=4.14 && <5
                  , http-types >=0.12 && <0.13
                  , wai >=3.2 && <3.3
                  , warp >=3.4 && <3.5
  ghc-options:      -threaded
  default-language: Haskell2010

test-suite spec
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test src
  other-modules:    App
  build-depends:    base >=4.14 && <5
                  , hspec >=2.11 && <2.12
                  , http-types >=0.12 && <0.13
                  , wai >=3.2 && <3.3
                  , wai-extra >=3.1 && <3.2
  default-language: Haskell2010
