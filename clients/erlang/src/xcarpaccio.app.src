{application, xcarpaccio,
 [
  {description, "Minimal Erlang client for the Extreme Carpaccio kata"},
  {vsn, "0.1.0"},
  {registered, []},
  {applications, [
                  kernel,
                  stdlib,
                  cowboy
                 ]},
  {mod, {xcarpaccio_app, []}},
  {env, [{http_port, 3000}]}
 ]}.
