{
  "name": "extreme-carpaccio/client-php",
  "description": "Extreme Carpaccio client in plain PHP",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "ExtremeCarpaccio\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ExtremeCarpaccio\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "start": "php -S 0.0.0.0:3000 -t public public/index.php",
    "test": "phpunit"
  }
}
